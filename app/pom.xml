<!-- STEP 4a: Maven build file for the sample Spring Boot app.
     "mvn clean package" produces target/demo-0.0.1-SNAPSHOT.jar
     "mvn deploy" (with distributionManagement below) pushes it to Nexus -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>demo</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.0</version>
  </parent>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <!-- exposes /actuator/prometheus for metrics scraping -->
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <!-- Points "mvn deploy" at your Nexus repository -->
  <distributionManagement>
    <repository>
      <id>nexus</id>
      <url>http://44.201.48.31:8081/repository/devops-pipeline-cicd/</url>
    </repository>
    <snapshotRepository>
      <id>nexus</id>
      <url>http://44.201.48.31:8081/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>
</project>
